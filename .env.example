# Hyper3D Rodin (Deemos) Generative 3D API
# Obtain your API key at https://hyper3d.ai or https://developer.hyper3d.ai
# DO NOT commit real API keys to version control.
RODIN_API_KEY=your_hyper3d_rodin_api_key_here

# Optional: Default Generation Tier ('Gen-2.5' or 'Gen-2')
RODIN_DEFAULT_TIER=Gen-2.5

# Optional: Server Port (defaults to 3001)
PORT=3001
